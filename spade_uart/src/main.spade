use protocols::uart::{uart_tx, uart_rx, UartConfig, UartOut};
use ready_valid::Rv;

#[no_mangle(all)]
entity top(
    clk: clock,
    rst_i: bool,
    led: inv [bool; 6],
    TXD: inv bool,
    RXD: bool,
) {
    let rst = rst_i;

    // The clock is 27 MHz
    // Count clocks, resetting to 0 every 0.25s
    reg(clk) counter: uint<25> reset(rst: 0) = if counter == 6_750_000  {
        0
    } else {
        trunc(counter + 1)
    };

    // When ready transitions from true->false, it means the UART is processing the byte
    // When ready transitions from false->true, it means the UART is done processing a byte
    let (ready, ready_inv) = port::<bool>();

    struct State {
        char: uint<8>,
        valid: bool,
    }

    reg(clk) state: State reset(rst: State(char: b'\r', valid: false)) = match (counter, ready, state.valid) {
        (0, _, _) => {
            // On the timer, send the next char
            State(char: state.char, valid: true)
        },
        (_, true, true) => {
            // This branch means that the character was just successfully sent
            // Advance the character
            // If the previously printed character was whitespace, immediately print the next character
            // otherwise, wait until the next counter == 0 to  send the next character
            match state.char {
                b'\r' => State(char: b'\n', valid: true),
                b'\n' => State(char: b'a', valid: true),
                b'z' => State(char: b'\r', valid: false),
                _ => State(char: trunc(state.char + 1), valid: false),
            }
        },
        _ => {
            // This means that we're either waiting for the byte to be sent
            // or we're waiting for counter == 0
            // Either way, don't change the state
            state
        }
    };

    let value = if state.valid {
        Some(state.char)
    } else {
        None
    };
    let rv = Rv(value, ready_inv);

    let uart_config = UartConfig(
        bit_time: 234,
        parity: false,
        stop_bits: 1,
    );

    set TXD = inst uart_tx(clk, rst, rv, uart_config);

    let rx = inst uart_rx(clk, rst, RXD, uart_config);

    // Display the low 6 bits of the last byte received
    reg(clk) last_byte_received reset(rst: 0) = if let UartOut::Ok(byte) = rx {
        byte
    } else {
        last_byte_received
    };
    set led = (~trunc::<_, uint<6>>(last_byte_received)).as_bits();
}
