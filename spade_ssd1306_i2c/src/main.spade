use i2c::{i2c_controller, Config, Req, Output, Status, AddrRw, Addr, Rw};
use ready_valid::Rv;


enum State {
    Start { ack: Option<bool> },
    WriteByte { i: uint<5>, ack: Option<bool> },
    Stop { error: bool },
    Done { error: bool },
}

struct S {
    req: Option<Req>,
    next_state: State,
}

struct O {
    sda: bool,
    scl: bool,
    leds: [bool; 6],
}

entity ssd1306<#uint N>(
    // 27 MHz
    clk: clock,
    rst: bool,
    sda: bool,
    scl: bool,
    config: Config<N>,
) -> O {
    let (ready, ready_inv) = port();
    let bytes = [
        0x00,                               // Control byte: command stream
        0xAE,                               // Display OFF
        0xD5, 0x80,                         // Clock divide / oscillator frequency
        0xA8, 0x3F,                         // Multiplex ratio (64 rows for 128x64)
        0xD3, 0x00,                         // Display offset (0)
        0x40,                               // Display start line (0)
        0x8D, 0x14,                         // Enable internal charge pump (crucial for ssd1306!)
        0x20, 0x00,                         // Horizontal addressing mode
        0xA1,                               // Segment re-map (col 127 -> SEG0)
        0xC8,                               // COM scan direction (remapped)
        0xDA, 0x12,                         // COM pins hardware config (0x12 for 128x64; 0x02 for 128x32)
        0x81, 0xCF,                         // Contrast control
        0xD9, 0xF1,                         // Pre-charge period (recommended for internal charge pump)
        0xDB, 0x40,                         // VCOMH deselect level
        0x2E,                               // Deactivate scroll
        0xA5,                               // Resume to GDDRAM (use 0xA5 for all-pixels-ON test)
        0xA6,                               // Normal (non-inverted) display
        0xAF                                // Display ON
    ];
    decl output;
    decl state;
    let s = match state {
        State::Start(ack) => {
            let ack = match (ack, output.status) {
                (Some(ack), _) => Some(ack),
                (_, Some(Status::Ack)) => Some(true),
                (_, Some(Status::Nack)) => Some(false),
                _ => None,
            };
            S {
                req: Some(Req::Start(AddrRw(Addr::_7Bit(0x3C), Rw::Write))),
                next_state: match (ack, ready) {
                    (Some(true), true) => State::WriteByte(0, None),
                    (Some(false), true) => State::Stop(true),
                    _ => State::Start(ack),
                },
            }
        },
        State::WriteByte(i, ack) => {
            let ack = match (ack, output.status) {
                (Some(ack), _) => Some(ack),
                (_, Some(Status::Ack)) => Some(true),
                (_, Some(Status::Nack)) => Some(false),
                _ => None,
            };
            S {
                req: Some(Req::WriteByte(bytes[i])),
                next_state: match (ack, ready, i == bytes.len()) {
                    (Some(true), true, false) => State::WriteByte(i +. 1, None),
                    (Some(true), true, true) => State::Stop(false),
                    (Some(false), true, _) => State::Stop(true),
                    _ => State::WriteByte(i, ack),
                },
            }
        },
        State::Stop(error) => {
            S {
                req: Some(Req::Stop),
                next_state: if ready {
                    State::Done(error)
                } else {
                    State::Stop(error)
                }
            }
        },
        State::Done(error) => S {
            req: None,
            next_state: State::Done(error),
        },
    };
    reg(clk) state initial(State::Start(None)) reset(rst: State::Start(None)) = s.next_state;

    let output = inst i2c_controller(
        clk,
        rst,
        sda,
        scl,
        Rv(s.req, ready_inv),
        config,
    );

    reg(clk) received_ack initial(false) reset(rst: false) = received_ack || match output.status {
        Some(Status::Ack) => true,
        _ => false,
    };
    reg(clk) received_nack initial(false) reset(rst: false) = received_nack || match output.status {
        Some(Status::Nack) => true,
        _ => false,
    };

    let is_done_ok = match state {
        State::Done(false) => true,
        _ => false,
    };
    let is_done_err = match state {
        State::Done(true) => true,
        _ => false,
    };
    O {
        sda: output.sda,
        scl: output.scl,
        leds: [is_done_ok, is_done_err, output.sda, output.scl, sda, scl],
    }
}

#[no_mangle(all)]
entity top(
    // 27 MHz
    clk: clock,
    rst: bool,
    leds: inv [bool; 6],
    ssd1306_scl: inout<bool>,
    ssd1306_sda: inout<bool>,
) {
    let (scl, scl_inv) = ssd1306_scl.read_write();
    let (sda, sda_inv) = ssd1306_sda.read_write();
    let config = Config::<7> {
        // From SSD1309: 0.6 us
        start_hold_cycles: 17,
        // From SSD1309: 0.3 us
        data_hold_cycles: 9,
        // From SSD1309: 0.1 us
        data_setup_cycles: 3,
        // From i2c spec: 1.3 us
        scl_low_cycles: 36,
        // From i2c spec: 0.6 us
        scl_high_cycles: 17,
        // From SSD1309: 2.5 us (400 kHz speed)
        scl_cycles: 68,
        // From SSD1309: 0.6 us
        stop_setup_cycles: 17,
        // From SSD1309: 1.3 us
        after_stop_cycles: 36,
        // From i2c spec and ssd1306 spec: 0.6 us
        restart_setup_cycles: 17,
    };
    let sda = sda == Some(true);
    let scl = scl == Some(true);
    let output = inst ssd1306(clk, rst, sda, scl, config);
    set scl_inv = if output.scl { None } else { Some(false) };
    set sda_inv = if output.sda { None } else { Some(false) };
    set leds = output.leds.map(fn |x| !x);
}

entity ssd1306_th(
    // 27 MHz
    clk: clock,
    rst: bool,
    sda: bool,
    scl: bool,
    config: Config<5>,
) -> O {
    inst ssd1306(clk, rst, sda, scl, config)
}
