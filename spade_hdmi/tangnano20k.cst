IO_LOC "clk" 4;
CLOCK_LOC "clk" BUFG;

IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;

IO_LOC "clk_i" 4;
CLOCK_LOC "clk_i" BUFG;

IO_LOC "key_i" 87;
IO_PORT "key_i" IO_TYPE=LVCMOS33;
IO_LOC "rst" 88;
IO_PORT "rst" IO_TYPE=LVCMOS33;

// USB-C UART
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" PULL_MODE=NONE;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" PULL_MODE=NONE;

IO_LOC "hdmi_hpd" 26;
IO_PORT "hdmi_hpd" PULL_MODE=NONE;

IO_LOC "hdmi_dcd_clk" 53;
IO_PORT "hdmi_dcd_clk" PULL_MODE=NONE;

IO_LOC "hdmi_dcd_dat" 52;
IO_PORT "hdmi_dcd_dat" PULL_MODE=NONE;
