mod ws2812;

use ready_valid::Rv;
use ws2812::{Ws2812Config, Pixel, Request};

enum Step {
    SetColor { pixels_left: uint<6> },
    Reset,
    Wait { cycles_left: uint<21> },
}

struct State {
    pos: uint<8>,
    step: Step,
}

/// Based on <https://github.com/kalkyl/ws2812-async/blob/5b4db3b84938cf44cbe2573ec982c5f85c76285d/examples/src/bin/rainbow.rs>
pub fn wheel(wheel_pos: uint<8>) -> Pixel {
    let pos = 255 -. wheel_pos;

    if pos < 85 {
        let scaled = trunc(pos * 3_u8);
        Pixel {
            r: 255 -. scaled,
            g: 0,
            b: scaled,
        }
    } else if pos < 170 {
        let offset = pos -. 85;
        let scaled = trunc(offset * 3_u8);
        Pixel {
            r: 0,
            g: scaled,
            b: 255 -. scaled,
        }
    } else {
        let offset = pos -. 170;
        let scaled = trunc(offset * 3_u8);
        Pixel {
            r: scaled,
            g: 255 -. scaled,
            b: 0,
        }
    }
}

#[no_mangle(all)]
entity top(
    clk: clock,
    rst: bool,
    btn: bool,
    led: inv [bool; 6],
    ws2812_pin: inv bool,
) {
    let (ready, ready_inv) = port();

    let ws2812_config = Ws2812Config::<11> {
        t_350_ns: 9,
        t_700_ns: 19,
        t_800_ns: 22,
        t_600_ns: 16,
        t_50_us: 1350,
    };

    // 64 total pixels
    let initial_pixels_left = 63;
    let pixel_pos_shift = 1_u8;
    // Dim the pixel because the LEDs get super bright
    let right_shift_value = 0;
    // Approximately 10s per cycle
    let wait_time = 1_057_420;
    let initial_state = State {
        pos: 0,
        step: Step::SetColor { pixels_left: initial_pixels_left },
    };
    reg(clk) state initial(State { pos: 0, step: Step::SetColor { pixels_left: 63 } }) reset(rst: initial_state) = match (state.step, ready) {
        (Step::SetColor { pixels_left }, true) => if pixels_left == 0 {
            State { pos: state.pos, step: Step::Reset }
        } else {
            State { pos: state.pos, step: Step::SetColor { pixels_left: pixels_left -. 1 } }
        },
        (Step::Reset, true) => State { pos: state.pos, step: Step::Wait { cycles_left: wait_time } },
        (Step::Wait { cycles_left }, _) => if cycles_left == 0 {
            State { pos: state.pos +. 1, step: Step::SetColor { pixels_left: initial_pixels_left } }
        } else {
            State { pos: state.pos, step: Step::Wait { cycles_left: cycles_left -. 1 } }
        },
        _ => state,
    };
    let request = match state.step {
        Step::SetColor { pixels_left } => Some(Request::SendPixel {
            pixel: wheel(state.pos +. trunc(pixels_left * pixel_pos_shift)).right_shift(right_shift_value)
        }),
        Step::Reset => Some(Request::SendReset),
        _ => None
    };

    set ws2812_pin = inst ws2812::ws2812(clk, rst, Rv(request, ready_inv), ws2812_config);

    let n: uint<6> = trunc(state.pos);
    set led = (~n).as_bits();
}
